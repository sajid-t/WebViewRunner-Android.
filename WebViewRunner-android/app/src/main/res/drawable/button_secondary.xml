<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle"><solid android:color="@color/runner_surface_raised" /><stroke android:width="1dp" android:color="@color/runner_blue" /><corners android:radius="10dp" /></shape>
    </item>
    <item>
        <shape android:shape="rectangle"><solid android:color="@color/runner_surface" /><stroke android:width="1dp" android:color="@color/runner_line" /><corners android:radius="10dp" /></shape>
    </item>
</selector>
